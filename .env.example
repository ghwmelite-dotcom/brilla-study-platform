# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API URL (Cloudflare Workers API)
VITE_API_URL=http://localhost:8787/api

# Enables automatic student onboarding for Counselor Brie (manual My Plan remains available).
VITE_COUNSELOR_BRIE_ENABLED=false

# For production, use:
# VITE_API_URL=https://brilla-api.your-domain.workers.dev/api
