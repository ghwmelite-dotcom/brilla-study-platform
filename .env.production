# Production build-time vars (loaded automatically by `vite build`).
# The SPA calls the API worker directly at this origin; if unset the bundle
# falls back to relative /api and every request hits the Pages SPA fallback
# (index.html) instead of the API.
VITE_API_URL=https://brilla-api.ghwmelite.workers.dev/api

# Fail-closed default; release tooling must explicitly opt in only after authenticated QA passes.
VITE_COUNSELOR_BRIE_ENABLED=false
