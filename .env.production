# ============================================================================
# WARNING: This file is COMMITTED TO GIT on purpose — Cloudflare Pages reads
# it at build time. It must ONLY ever contain PUBLIC `VITE_*` values that are
# safe to ship inside the client bundle (they are public by definition).
#
# NEVER put secrets in this file. Secrets belong in:
#   - `.dev.vars` (local dev; see `.dev.vars.example`, gitignored), or
#   - `wrangler secret put <NAME>` / `wrangler secret put <NAME> --env staging`
#     (Worker runtime secrets; see the comment block in `wrangler.toml`)
# ============================================================================

# Production build-time vars (loaded automatically by `vite build`).
# The SPA calls the API worker directly at this origin; if unset the bundle
# falls back to relative /api and every request hits the Pages SPA fallback
# (index.html) instead of the API.
VITE_API_URL=https://brilla-api.ghwmelite.workers.dev/api

# Enabled after production migration, student authorization, and assessment QA gates passed.
VITE_COUNSELOR_BRIE_ENABLED=true
