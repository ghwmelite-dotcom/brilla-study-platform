    "sql": "EXPLAIN QUERY PLAN SELECT s.*, sc.name AS category_name, sc.slug AS category_slug, sc.is_core, et.name AS exam_type_name, et.slug AS exam_type_slug, COALESCE(qc.question_count, 0) AS question_count, COALESCE(tc.topic_count, 0) AS topic_count FROM subjects s LEFT JOIN subject_categories sc ON s.category_id = sc.id LEFT JOIN exam_types et ON s.exam_type_id = et.id LEFT JOIN (SELECT subject_id, COUNT(*) AS question_count FROM questions GROUP BY subject_id) qc ON qc.subject_id = s.id LEFT JOIN (SELECT subject_id, COUNT(*) AS topic_count FROM topics GROUP BY subject_id) tc ON tc.subject_id = s.id WHERE s.is_active = 1 ORDER BY COALESCE(sc.display_order, 9999), s.display_order, s.name",
