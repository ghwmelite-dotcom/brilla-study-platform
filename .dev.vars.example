# Copy to .dev.vars and fill in real values for local development.
# Never commit .dev.vars.
JWT_SECRET=change-me-generate-a-secure-random-string
SETUP_KEY=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
TURNSTILE_SECRET=
ANTHROPIC_API_KEY=
# Optional Workers AI model override for exam/essay marking (defaults to @cf/openai/gpt-oss-120b)
AI_MODEL_MARKING=
# Telegram community bot (local dev placeholders — real token/secret go in .dev.vars)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PLATFORM_CHANNEL_ID=
TELEGRAM_COMMUNITY_URL=
# Overrides the [vars] APP_URL from wrangler.toml during local dev
APP_URL=http://localhost:5173
