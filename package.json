{
  "name": "brilla-study-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --env dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "node scripts/configure-pages-headers.mjs --check && tsc -b && vite build && node scripts/verify-bundle-budget.mjs && node scripts/configure-pages-headers.mjs",
    "lint": "eslint src workers scripts",
    "typecheck:api": "tsc -p workers/tsconfig.json",
    "lint:api": "eslint workers",
    "preview": "vite preview",
    "db:verify:prod-cache": "node scripts/verify-ai-answer-cache-production.mjs",
    "db:audit:questions": "node scripts/audit-question-bank.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:any-budget": "node scripts/check-any-budget.mjs",
    "db:verify": "node scripts/verify-db.cjs && node scripts/verify-fresh-bootstrap.cjs && node scripts/verify-mock-configs.cjs",
    "db:schema": "wrangler d1 execute brilla-db --local --file=database/schema.sql",
    "db:seed": "wrangler d1 execute brilla-db --local --file=database/seed.sql",
    "db:seed:topics": "wrangler d1 execute brilla-db --local --file=database/prod-patches/094_seed_missing_subjects_topics.sql && wrangler d1 execute brilla-db --local --file=database/prod-patches/095_clone_topics_to_current_subjects.sql && wrangler d1 execute brilla-db --local --file=database/prod-patches/096_seed_topics_for_empty_subjects.sql",
    "db:baseline:fresh": "wrangler d1 execute brilla-db --local --file=database/record_folded_migrations.sql",
    "db:baseline": "wrangler d1 migrations apply brilla-db",
    "db:backup": "wrangler d1 export brilla-db --remote --output=backups/brilla-db-$(date +%Y%m%d-%H%M%S).sql",
    "db:backup:staging": "wrangler d1 export brilla-db-staging --env staging --remote --output=backups/brilla-db-staging-$(date +%Y%m%d-%H%M%S).sql",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "framer-motion": "^12.23.26",
    "hono": "^4.13.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.0",
    "warning": "^4.0.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@eslint/js": "^9.13.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.6.0",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "wrangler": "^4.121.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
